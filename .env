# ==============================================================================
# MedGraphRAG Docker Compose Environment Configuration
# ==============================================================================

# Project Name
COMPOSE_PROJECT_NAME=medgraph

# JWT Security
JWT_SECRET=medgraph_super_secret_jwt_key_2026_09_15_secure_key_1234567890
JWT_EXPIRE_HOURS=12

# Database Credentials
NEO4J_AUTH=neo4j/MedGraph123!
MONGO_INITDB_ROOT_USERNAME=medgraph
MONGO_INITDB_ROOT_PASSWORD=MedGraph123!
MONGO_INITDB_DATABASE=medgraph
REDIS_PASSWORD=

# XXL-Job Scheduler
XXL_JOB_ACCESS_TOKEN=medgraph_xxl_job_token

# AI / LLM Configuration (Optional, defaults to mock generator if empty)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
EMBED_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Crawler Configuration
CRAWLER_MODE=hybrid
CRAWLER_RUN_ON_START=false
CRAWLER_REQUEST_INTERVAL_MS=1000
CRAWLER_MAX_RETRY=3
CRAWLER_FALLBACK_THRESHOLD=10
CRAWLER_DAILY_LIMIT=20000
CRAWLER_KAFKA_TOPIC=medical_raw_topic
