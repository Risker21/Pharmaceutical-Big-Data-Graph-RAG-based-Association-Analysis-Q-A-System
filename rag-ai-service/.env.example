APP_NAME=MedGraphRAG-AIService
APP_ENV=development
APP_PORT=8000

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
USE_MOCK_LLM=true

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_DATABASE=neo4j
USE_MOCK_NEO4J=true

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=clinical_embeddings
VECTOR_DIM=384
USE_MOCK_MILVUS=true

HBASE_HOST=localhost
HBASE_PORT=9090
HBASE_TABLE=medical_corpus:drug_detail
USE_MOCK_HBASE=true

REDIS_URL=redis://localhost:6379/2
USE_MOCK_REDIS=true

LOG_LEVEL=INFO
ENABLE_CORS=true
CORS_ORIGINS=*

HYBRID_TOP_K=10
RERANK_TOP_N=6
GRAPH_MAX_HOPS=2
